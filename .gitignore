<svg xmlns="http://www.w3.org/2000/svg" width="1400" height="800" viewBox="0 0 1400 800" role="img" aria-labelledby="title desc">
  <title id="title">Red Team Operations Overview</title>
  <desc id="desc">Workflow diagram for planning, validation, detection, and reporting</desc>
  <defs>
    <linearGradient id="blue" x1="0" x2="1">
      <stop offset="0%" stop-color="#60a5fa"/>
      <stop offset="100%" stop-color="#14b8a6"/>
    </linearGradient>
    <linearGradient id="dark" x1="0" x2="1">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#111827"/>
    </linearGradient>
  </defs>
  <rect width="1400" height="800" fill="#020817"/>
  <g font-family="Segoe UI, Arial, sans-serif" fill="#e2e8f0">
    <rect x="70" y="120" width="220" height="120" rx="18" fill="url(#dark)" stroke="#60a5fa"/>
    <text x="180" y="170" text-anchor="middle" font-size="28" font-weight="700">Scope</text>
    <text x="180" y="205" text-anchor="middle" font-size="20">Auth + Assets</text>

    <rect x="330" y="120" width="220" height="120" rx="18" fill="url(#dark)" stroke="#60a5fa"/>
    <text x="440" y="170" text-anchor="middle" font-size="28" font-weight="700">Recon</text>
    <text x="440" y="205" text-anchor="middle" font-size="20">Inventory + Map</text>

    <rect x="590" y="120" width="220" height="120" rx="18" fill="url(#dark)" stroke="#60a5fa"/>
    <text x="700" y="170" text-anchor="middle" font-size="28" font-weight="700">Access</text>
    <text x="700" y="205" text-anchor="middle" font-size="20">Identity + Abuse</text>

    <rect x="850" y="120" width="220" height="120" rx="18" fill="url(#dark)" stroke="#60a5fa"/>
    <text x="960" y="170" text-anchor="middle" font-size="28" font-weight="700">Movement</text>
    <text x="960" y="205" text-anchor="middle" font-size="20">Lateral + Persistence</text>

    <rect x="1110" y="120" width="220" height="120" rx="18" fill="url(#dark)" stroke="#60a5fa"/>
    <text x="1220" y="170" text-anchor="middle" font-size="28" font-weight="700">Report</text>
    <text x="1220" y="205" text-anchor="middle" font-size="20">Risk + Remediation</text>

    <path d="M290 180 H330" stroke="url(#blue)" stroke-width="8"/>
    <path d="M550 180 H590" stroke="url(#blue)" stroke-width="8"/>
    <path d="M810 180 H850" stroke="url(#blue)" stroke-width="8"/>
    <path d="M1070 180 H1110" stroke="url(#blue)" stroke-width="8"/>

    <rect x="370" y="390" width="660" height="220" rx="20" fill="#0f172a" stroke="#14b8a6"/>
    <text x="700" y="455" text-anchor="middle" font-size="32" font-weight="700">Detection + Defensive Validation</text>
    <text x="700" y="500" text-anchor="middle" font-size="22">Validate telemetry, response quality, and control effectiveness</text>
    <text x="700" y="540" text-anchor="middle" font-size="22">Map findings to ATT&amp;CK-aligned adversary behavior</text>
    <text x="700" y="580" text-anchor="middle" font-size="22">Prioritize risk by operational impact and business consequence</text>
  </g>
</svg>

